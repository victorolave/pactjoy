{
  "name": "@pactjoy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres adapter for the ports of @pactjoy/app. The only package allowed to import the database driver.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pactjoy/app": "workspace:*",
    "@pactjoy/engine": "workspace:*",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.0.0",
    "@types/node": "^24.0.0",
    "vitest": "^5.0.1"
  }
}
