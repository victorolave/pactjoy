{
  "name": "@pactjoy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PactJoy PWA: a hexagonal Vite + React SPA that talks to the API through ports (ADR-0012).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@pactjoy/app": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
